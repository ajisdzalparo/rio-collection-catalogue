# ==============================================
# RIO COLLECTION — ENVIRONMENT CONFIGURATION
# ==============================================

# --- Application & Server ---
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# --- Database (PostgreSQL / Supabase / Neon) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rio_catalogue?schema=public"

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="rio-collection-bucket"
MINIO_REGION="us-east-1"
MINIO_FORCE_PATH_STYLE="true"
NEXT_PUBLIC_MINIO_PUBLIC_URL="http://localhost:9000/rio-collection-bucket"

# --- Authentication & JWT Security ---
JWT_SECRET="super-secret-admin-jwt-key-min-32-chars"
CUSTOMER_JWT_SECRET="super-secret-customer-jwt-key-min-32-chars"

# --- RajaOngkir Shipping API ---
RAJAONGKIR_API_KEY=""
RAJAONGKIR_ACCOUNT_TYPE="starter"
RAJAONGKIR_ORIGIN_CITY_ID="252"

# --- Email / SMTP (Gmail App Password or SMTP Service) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-16-char-app-password"
SMTP_FROM="RIO COLLECTION <your-email@gmail.com>"

# --- Google reCAPTCHA (Optional) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Admin Seeding (Optional) ---
ADMIN_NAME="Admin RIO COLLECTION"
ADMIN_EMAIL="admin@riocollection.com"


