# ==============================================================================
# RIO Collection Catalogue - Environment Configuration Template
# ==============================================================================

# Application & API Base URL
NEXT_PUBLIC_API_URL=/api

# External PostgreSQL Database Connection URL
# Example Supabase / Neon / RDS / VPS Postgres:
DATABASE_URL="postgresql://username:password@your-db-host:5432/rio_collection?schema=public&sslmode=prefer"

# S3 / MinIO Storage Configuration
MINIO_ENDPOINT=https://s3.your-region.amazonaws.com # or http://your-minio-host:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET_NAME=rio-collection-bucket
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://your-bucket-public-url.com

# Google reCAPTCHA (Optional / Production)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# RajaOngkir Shipping API Configuration
RAJAONGKIR_API_KEY=your_rajaongkir_api_key
RAJAONGKIR_ACCOUNT_TYPE=starter # starter | basic | pro
RAJAONGKIR_ORIGIN_CITY_ID=252

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_here
