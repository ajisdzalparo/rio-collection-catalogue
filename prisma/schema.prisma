// Prisma Schema for RIO Collection Catalogue & Backend API

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("Admin")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Color {
  id        String    @id @default(cuid())
  name      String
  hex       String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model Size {
  id        String    @id @default(cuid())
  size      String    @unique
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  edition          String           @default("Edition 001")
  category         String
  color            String
  colorHex         String
  colors           String[]
  colorHexes       String[]
  price            Int
  hpp              Int?
  stock            Int              @default(0)
  stockMode        String           @default("QUANTITY") // QUANTITY, ALWAYS_AVAILABLE
  status           String           @default("AVAILABLE") // AVAILABLE, SOLD_OUT, COMING_SOON
  imageUrl         String
  images           String[]
  imageDetails     Json?
  description      String
  storyTitle       String?
  storyText        String?
  materialsAndCare Json?
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  inStock   Boolean @default(true)
  stock     Int     @default(0)
}

model Archive {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("SOLD_OUT")
  imageUrl    String
  description String
  journalId   String?
  journal     Journal? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Journal {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  author             String
  date               String
  category           String
  imageUrl           String
  excerpt            String
  content            String[]
  contentHtml        String?
  archives           Archive[]
  pullQuote          String?
  relatedProductSlug String?
  createdAt          DateTime @default(now())
}

model Topic {
  id          String    @id @default(cuid())
  name        String
  description String
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Testimony {
  id        String   @id @default(cuid())
  alt       String
  imageUrl  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  fullName       String
  whatsapp       String
  address        String
  notes          String?
  adminNotes     String?
  courierName                    String?
  trackingNumber                 String?
  quotedShippingFee              Int         @default(15000)
  shippingFee                    Int         @default(15000)
  shippingAdjustmentAmount       Int         @default(0)
  shippingAdjustmentStatus       String      @default("NONE") // NONE, CUSTOMER_CONFIRMATION_PENDING, CUSTOMER_CONFIRMED, REFUNDED, REFUND_WAIVED
  shippingAdjustmentNote         String?
  shippingAdjustmentWaSent      Boolean     @default(false)
  paymentProofUrl                String?
  additionalPaymentProofUrl      String?
  refundProofUrl                 String?
  shippingProofUrl               String?
  totalPrice                     Int
  status                         String      @default("PENDING") // PENDING, PAID, FULFILLED, CANCELLED
  waFollowedUp                   Boolean     @default(false)
  items                          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  size      String
  price     Int
  quantity  Int
  isPreOrder Boolean?
  createdAt DateTime @default(now())
}

model StoreSettings {
  id                String   @id @default("default")
  storeName         String
  whatsappNumber    String
  bankName          String?
  bankAccountNumber String?
  bankAccountOwner  String?
  flatShippingRate  Int
  instagramUrl      String?
  tiktokUrl         String?
  facebookUrl       String?
  pinterestUrl      String?
  xTwitterUrl       String?
  heroTitle         String?
  heroSubtitle      String?
  heroLayout        String?  @default("2-grid")
  heroLeftImage     String?
  heroCenterImage   String?
  heroRightImage    String?
  heroCtaText       String?
  heroCtaLink       String?
  homeFeaturedTitle String?
  homeViewAllLabel  String?
  homeManifestoTitle String?
  homeManifestoText String?
  homeManifestoImage String?
  homeBannerText    String?
  homeBannerButton  String?
  archiveHeaderSub  String?
  archiveQuoteTitle String?
  archiveQuoteText  String?
  aboutHeroImage    String?
  aboutHeading      String?
  aboutParagraph1   String?
  aboutParagraph2   String?
  aboutValuesTitle  String?
  aboutValues       Json?
  aboutQuote        String?
  aboutQuoteText    String?
  aboutStudioImage  String?
  contactEmail      String?
  waTemplatePending  String?
  waTemplatePayment  String?
  waTemplateShipping String?
  waTemplateRemind   String?
  enabledCouriers    String?
  originCityId       String?
  originCityName     String?
  originProvinceName String?
  updatedAt         DateTime @updatedAt
}

/// Master bank — daftar bank yang tersedia untuk dipilih toko
model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  // e.g. BCA, BNI, MANDIRI
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Rekening bank toko — bisa lebih dari satu, client hanya melihat yang isActive
model StoreBank {
  id                String   @id @default(cuid())
  bankName          String
  accountNumber     String
  accountOwner      String
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Cache tarif ongkir lokal agar hemat API limit RajaOngkir dan respon super cepat (0ms)
model ShippingRateCache {
  id                 String   @id @default(cuid())
  originCityId       String
  destinationCityId  String
  courier            String
  weightGrams        Int      @default(1000)
  ratesData          Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([originCityId, destinationCityId, courier, weightGrams])
  @@index([destinationCityId, courier])
}
